  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/B5-Software/just-a-player#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/B5-Software/just-a-player.git"
  },
  "description": "Just A Player",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && node scripts/prepare-media-tools.mjs && electron-vite dev",
    "build": "node scripts/prepare-media-tools.mjs && electron-vite build",
    "package": "node scripts/prepare-media-tools.mjs && node scripts/prepare-package.mjs && electron-builder --config electron-builder.yml",
    "media:prepare": "node scripts/prepare-media-tools.mjs",
    "test:e2e:media": "node scripts/e2e-media.mjs",
    "test:e2e:release": "node scripts/e2e-release.mjs",
    "test:e2e:smoke": "node scripts/e2e-smoke.mjs",
    "test:e2e:memory": "node scripts/e2e-memory.mjs",
    "test:e2e:fallback": "node scripts/e2e-fallback.mjs",
    "preview": "node scripts/ensure-electron.mjs && node scripts/prepare-media-tools.mjs && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e:audio": "node scripts/e2e-audio.mjs",
    "test:e2e:features": "node scripts/e2e-features.mjs",
    "test:e2e:desktop": "node scripts/e2e-desktop.mjs",
    "test:e2e:polish": "node scripts/e2e-polish.mjs",
    "test:e2e:renderer": "node scripts/e2e-renderer.mjs",
    "test:e2e:stage": "node scripts/e2e-stage.mjs",
    "fonts:vendor": "node scripts/vendor-fonts.mjs"
  },
  "dependencies": {
    "@jap/engine": "workspace:*",
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@fontsource/liu-jian-mao-cao": "^5.3.0",
    "@fontsource/long-cang": "^5.3.0",
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "@fontsource/zcool-xiaowei": "^5.3.0",
    "@fontsource/zhi-mang-xing": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "motion": "^14.3.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
}
