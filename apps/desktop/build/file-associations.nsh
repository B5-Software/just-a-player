  DeleteRegValue SHCTX "Software\Classes\.dsf\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.dff\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.ncm\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.ape\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.dts\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.dtshd\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.iso\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.cue\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.mid\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.midi\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.kar\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.rmi\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.m3u\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.m3u8\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegKey SHCTX "Software\Classes\JustAPlayer.Audio"
  DeleteRegKey SHCTX "Software\JustAPlayer\Capabilities"
  DeleteRegValue SHCTX "Software\RegisteredApplications" "Just A Player"
!macroend
