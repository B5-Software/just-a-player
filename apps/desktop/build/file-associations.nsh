; File-opening registration adds an Open with choice; it never writes UserChoice.
!macro customInstall
  WriteRegStr SHCTX "Software\Classes\JustAPlayer.Audio" "" "Just A Player 音乐"
  WriteRegStr SHCTX "Software\Classes\JustAPlayer.Audio\Application" "ApplicationName" "Just A Player"
  WriteRegStr SHCTX "Software\Classes\JustAPlayer.Audio\DefaultIcon" "" '$INSTDIR\${APP_EXECUTABLE_FILENAME},0'
  WriteRegStr SHCTX "Software\Classes\JustAPlayer.Audio\shell\open\command" "" '$\"$INSTDIR\${APP_EXECUTABLE_FILENAME}$\" $\"%1$\"'
  WriteRegStr SHCTX "Software\Classes\.flac\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.wav\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.aiff\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.aif\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.mp3\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.m4a\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.aac\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.ogg\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.oga\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.opus\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.mka\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.caf\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.alac\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.dsf\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.dff\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.ncm\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.ape\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.dts\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.dtshd\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.iso\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.cue\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.mid\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.midi\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.kar\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.rmi\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.m3u\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\Classes\.m3u8\OpenWithProgids" "JustAPlayer.Audio" ""
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities" "ApplicationName" "Just A Player"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities" "ApplicationDescription" "HiFi music and immersive visualization"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".flac" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".wav" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".aiff" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".aif" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".mp3" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".m4a" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".aac" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".ogg" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".oga" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".opus" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".mka" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".caf" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".alac" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".dsf" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".dff" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".ncm" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".ape" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".dts" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".dtshd" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".iso" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".cue" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".mid" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".midi" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".kar" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".rmi" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".m3u" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\JustAPlayer\Capabilities\FileAssociations" ".m3u8" "JustAPlayer.Audio"
  WriteRegStr SHCTX "Software\RegisteredApplications" "Just A Player" "Software\JustAPlayer\Capabilities"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

!macro customUnInstall
  DeleteRegValue SHCTX "Software\Classes\.flac\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.wav\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.aiff\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.aif\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.mp3\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.m4a\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.aac\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.ogg\OpenWithProgids" "JustAPlayer.Audio"
  DeleteRegValue SHCTX "Software\Classes\.oga\OpenWithProgids" "JustAPlayer.Audio"
