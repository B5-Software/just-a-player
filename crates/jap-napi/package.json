{
  "name": "@jap/engine",
  "version": "0.1.2",
  "private": true,
  "author": "B5-Software",
  "license": "GPL-3.0-or-later",
  "description": "Just A Player audio engine (Rust, N-API)",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "jap-engine",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../Cargo.toml -p jap-napi",
    "build:debug": "napi build --platform --manifest-path ../../Cargo.toml -p jap-napi"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8"
  }
}
